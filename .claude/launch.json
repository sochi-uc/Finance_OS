{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "finance-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "server/src/FinanceOs.Api",
        "--launch-profile",
        "http"
      ],
      "port": 8787
    },
    {
      "name": "finance-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5174
    }
  ]
}